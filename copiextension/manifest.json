{
  "manifest_version": 3,
  "name": "Copio Extension",
  "version": "1.1",
  "description": "Copia testo formattato e incollalo direttamente nel popup!",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "clipboardWrite", 
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"], 
      "js": ["content.js"]
    }
  ],
  "host_permissions": [
    "<all_urls>"  
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "chrome.png",
      "48": "chrome.png",
      "128": "chrome.png"
    }
  }
}

