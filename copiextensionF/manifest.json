{
  "manifest_version": 2,
  "name": "Copio Extension",
  "version": "1.0",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "http://localhost:8080/*"  
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "chrome.png",
      "48": "chrome.png",
      "128": "chrome.png"
    }
  }
}
